---
import { getCollection, render } from 'astro:content';
import Base from '@/components/Base.astro';
import Expandable from '@/components/Expandable';
import '@/styles/pluginDoc.scss'
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const posts = await getCollection('plugins');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base class="plugin-doc">
    <Expandable startExpanded title={post.data.name + " Plugin Documentation"} client:load>
      {typeof post.data.description == 'string' || typeof post.data.homePage == 'string' ? <div class="info-headings">
        {typeof post.data.description == 'string' ? <p class="description">Description: {post.data.description}</p> : null}
        {typeof post.data.homePage == 'string' ? <a class="third-party-home standard-link" href={post.data.homePage}>View {post.data.name}'s Website</a> : null}
      </div> : null}
      <Content />
    </Expandable>
</Base>