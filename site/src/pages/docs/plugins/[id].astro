---
import { getCollection, render } from 'astro:content';
import Base from '@/components/Base.astro';
import Expandable from '@/components/Expandable';
import '@/styles/pluginDoc.scss'
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const posts = await getCollection('plugins');
  console.log(posts)
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base class="plugin-doc">
    <Expandable startExpanded title={post.data.name + " Plugin Documentation"} client:load>
      <div class="info-headings">
        {typeof post.data.description == 'string' ? <p class="description">Description:<br/>{post.data.description}</p> : null}
        <a class="source standard-link" target="_blank" href={typeof post.data.source == 'string' ? post.data.source : "https://github.com/L1lith/Lilis-Game-Engine/tree/master/src/plugins/" + post.id + '.js'}>Plugin Source Code</a>
        {typeof post.data.homePage == 'string' ? <a target="_blank" class="third-party-home standard-link" href={post.data.homePage}>View {post.data.name}'s Website</a> : null}
        {Array.isArray(post.data.demos) ? <span class="demos-used">Usage Demos: <ul>{post.data.demos.map((demo, i) => (<li><a href={import.meta.env.BASE_URL + 'demos/' + demo}>{demo}</a> <a href={"https://github.com/L1lith/Lilis-Game-Engine/tree/master/demos/" + demo}>(source)</a>{(i < post.data.demos.length - 1 ? ', ' : null)}</li>))}</ul></span> : null}
      </div>
      <Content />
    </Expandable>
</Base>