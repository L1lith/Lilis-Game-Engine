---
import '@/styles/global.scss'
import siteConfig from '@/configs/siteConfig.js'
import mime from 'mime/lite';
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import BackgroundAnimation from './BackgroundAnimation';
import { ClientRouter } from "astro:transitions";

let {title="Lili's Game Engine", image, description, noHeader=false, noFooter=false, class: className} = Astro.props
if (title.endsWith('-')) {
    title = title + ' Lili\'s Game Engine'
} else if (title.startsWith('-')) {
    title = 'Lili\'s Game Engine '
}
const {favicons=[]} = siteConfig
const maxDescriptionLength = 55
if (typeof description == 'string') {
    description = description.trim()
    if (description.length > maxDescriptionLength) {
        description = description.substring(0, maxDescriptionLength - 3).trim() + '...'
    }
}

---
<html lang="en">
    <head>
        <title>{title}</title>
        <meta content="width=device-width, initial-scale=1" name="viewport" />
        <meta property="og:title" content={title}>
        {typeof description == 'string' ? <meta property="og:description" content={description}/> : null}
        {typeof image == 'string' ? <meta property="og:image" content={new URL(image, import.meta.env.SITE).href}/> : null}
        <slot name="head"/>
             {favicons.map(favicon => {
      if ((typeof favicon != 'object' && typeof favicon != 'string') || favicon === null) throw new Error("Invalid Favicon")
      const url = typeof favicon == 'string' ? favicon : favicon.url
      let extension = url.split('.')
      extension = extension[extension.length - 1]
      let size = favicon?.size || null
      if (Array.isArray(size) && size.length === 1) size = [size[0], size[0]]
      if (typeof size == 'string') size = [size, size]
      const favMime = mime.getType(extension)
      return <link rel="shortcut icon" href={url} sizes={size ? size[0] + 'x' + size[1] : null} type={favMime}/>
     })}
     <ClientRouter />
    </head>
    <body>
        <BackgroundAnimation transition:persist transition:name="background-animation" client:load/>
        {noHeader ? null : <Header transition:persist/>}
        <main class={"main-content " + (typeof className == 'string' ? className : "")}>
            <slot/>
        </main>
        {noFooter ? null : <Footer transition:persist/>}
    </body>
</html>