---
import Base from '../components/Base.astro';
import '@/styles/demos.scss';
import GithubLogo from '@/svgs/github.svg'
import Carousel3D from '@/components/Carousel3D';

const base = import.meta.env.BASE_URL;

const panels = [
  {
    title: "Pong",
    preview: base + "pong-preview.png",
    href: base + "examples/pong",
    source: "https://github.com/L1lith/Lilis-Game-Engine/tree/master/examples/pong",
  },
  {
    title: "Angry Birds Knockoff",
    preview: base + "angry-birds-preview.png",
    href: base + "examples/spike-vs-space",
    source: "https://github.com/L1lith/Lilis-Game-Engine/tree/master/examples/spike-vs-space",
  },
  {title: "Sidescroller",
    preview: base + 'sidescroller-preview.png',
    href: base + 'examples/sidescroller',
    source: "https://github.com/L1lith/Lilis-Game-Engine/tree/master/examples/sidescroller"
  }
  // ...as many as you want
];
---

<Base>
  <Carousel3D panels={panels} cardWidth={320} cardHeight={420} zoom={1.15} client:load />
	<nav class="demo-list sr-only">
		<ul>
      {panels.map(panel => (
        <li>
<a class="demo-link" href={import.meta.env.BASE_URL + "examples/pong"}>
                    <h3>Pong</h3>
                </a>
                <a class="source" href="https://github.com/L1lith/Lilis-Game-Engine/tree/master/examples/pong"><GithubLogo/>View Source Code</a>
            </li>
      ))}
		</ul>
	</nav>
</Base>
