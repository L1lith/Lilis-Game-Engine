                    <img class="preview" src={import.meta.env.BASE_URL + "angry-birds-preview.png"}/>
                    <a href="https://github.com/L1lith/Lilis-Game-Engine/tree/master/examples/spike-vs-space">View Source Code</a>
                </a>
            </li>
		</ul>
	</nav>
