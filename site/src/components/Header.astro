import DocsNav from '@/svgs/docs-nav.svg'
import LiliNav from '@/svgs/lili-nav.svg'
---
<header class="site-header">
		<a href={import.meta.env.BASE_URL}><img height="500" width="475" class="site-logo" src={import.meta.env.BASE_URL + "lilis-game-engine-logo.png"} alt="Lili's Game Engine"/></a>
        <nav class="site-nav">
            <ul>
                <li>
                    <a href={import.meta.env.BASE_URL + "demos"}><DemoNav/></a>
                </li>
                <li>
                    <a href={import.meta.env.BASE_URL + "docs"}><DocsNav/></a>
                </li>
                <li>
                    <a href="https://webslc.com"><LiliNav/></a>
                </li>
            </ul>
        </nav>
	</header>