---
import Base from '../components/Base.astro';
import '@/styles/demos.scss';
import GithubLogo from '@/svgs/github.svg'
import Carousel3D from '@/components/Carousel3D';

const base = import.meta.env.BASE_URL;

const panels = [
  {
    title: "Pong",
    preview: base + "pong-preview.png",
    href: base + "demos/pong",
    source: "https://github.com/L1lith/Lilis-Game-Engine/tree/master/demos/pong",
  },
  {
    title: "Angry Birds Knockoff",
    preview: base + "angry-birds-preview.png",
    href: base + "demos/spike-vs-space",
    source: "https://github.com/L1lith/Lilis-Game-Engine/tree/master/demos/spike-vs-space",
  },
  { 
    title: "Sidescroller",
    preview: base + 'sidescroller-preview.png',
    href: base + 'demos/sidescroller',
    source: "https://github.com/L1lith/Lilis-Game-Engine/tree/master/demos/sidescroller"
  },
  {
    title: "Topdown Zelda Style",
    preview: base + 'topdown-preview.png',
    href: base + 'demos/topdown',
    source: "https://github.com/L1lith/Lilis-Game-Engine/tree/master/demos/topdown"
  }
  // ...as many as you want
];
---

<Base title="Play Demos -" class="demo-page">
  <Carousel3D panels={panels} width="90vw" height="50vmin" zoom={1.15} client:load />
	<nav class="demo-list sr-only">
		<ul>
      {panels.map(panel => (
        <li>
<a class="demo-link" href={import.meta.env.BASE_URL + "demos/pong"}>
                    <h3>Pong</h3>
                </a>
                <a class="source" href="https://github.com/L1lith/Lilis-Game-Engine/tree/master/demos/pong"><GithubLogo/>View Source Code</a>
            </li>
      ))}
		</ul>
	</nav>
</Base>
